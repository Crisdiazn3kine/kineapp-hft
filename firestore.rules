rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Cada kinesiólogo solo puede leer/escribir su propio perfil y sus subcolecciones
    match /kinesiologos/{kineId} {
      allow read, write: if request.auth != null && request.auth.uid == kineId;

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == kineId;
      }
    }

    // Biblioteca general: cualquier kinesiólogo logueado puede LEER,
    // pero solo tú (admin) puedes escribir/editar contenido.
    // Reemplaza ADMIN_UID por tu propio UID de Firebase Auth cuando lo tengas.
    match /biblioteca_general/{ejercicioId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == "ADMIN_UID";
    }
  }
}
